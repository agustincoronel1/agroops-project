APP_NAME=AgroOps Intelligence System
APP_VERSION=0.1.0
ENVIRONMENT=development
REDIS_URL=redis://redis:6379/0
# Never commit a real key. Leave empty to run without LLM (jobs will FAIL with a clear error).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required to use POST /tasks/{id}/approve (sent as header X-API-Key). Empty = approval disabled.
APPROVAL_API_KEY=
GRAPH_MAX_STEPS=4

# RAG (ChromaDB + OpenAI embeddings). In Docker Compose these are set automatically.
DEMO_ESTABLISHMENT_ID=demo
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=agroops_knowledge
RAG_TOP_K=4
# Max cosine distance (0 = identical); chunks farther than this are discarded.
RAG_MAX_DISTANCE=0.75
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
INGEST_DEMO_ON_STARTUP=true

# LangSmith observability (optional). Tracing is OFF unless LANGSMITH_TRACING=true AND a key is set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agroops-intelligence
# Only for EU/self-hosted: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
