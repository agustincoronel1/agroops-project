# Copy to .env and fill the keys. Optional for `docker compose up`: without a key the API
# runs, but every job fails with LLM_NOT_CONFIGURED.
#
# Values below are the LOCAL defaults (same as backend/app/core/config.py). Docker Compose
# overrides REDIS_URL, CHROMA_HOST and CHROMA_PORT for the container network, so these
# three only matter for local runs (for example, the integration tests).

APP_NAME=AgroOps Intelligence System
APP_VERSION=0.1.0
ENVIRONMENT=development

# Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required to use POST /tasks/{id}/approve (header X-API-Key). Empty = approval disabled.
APPROVAL_API_KEY=

# Redis Stack (RedisJSON + RediSearch). Compose publishes it on 127.0.0.1:6379.
REDIS_URL=redis://localhost:6379/0
GRAPH_MAX_STEPS=4

# RAG: ChromaDB + OpenAI embeddings. Compose publishes Chroma on 127.0.0.1:8001 (container port 8000).
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=agroops_knowledge
DEMO_ESTABLISHMENT_ID=demo
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
# Max cosine distance (0 = identical); chunks farther than this are discarded.
RAG_MAX_DISTANCE=0.75
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
INGEST_DEMO_ON_STARTUP=true

# LangSmith observability (optional). Tracing is OFF unless LANGSMITH_TRACING=true AND a key is set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agroops-intelligence
# Only for EU/self-hosted: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
